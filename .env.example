# Copy to .env for local development only. In production these are set as
# Supabase function secrets, never committed.

# --- Supabase provides these two automatically when deployed ---------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Telegram (required) ---------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AA...
# Comma separated. An empty list means nobody can talk to the bot, by design.
TELEGRAM_ALLOWED_CHAT_IDS=123456789
TELEGRAM_WEBHOOK_SECRET=make-up-something-long-and-random
CRON_SECRET=make-up-a-different-long-random-string

# --- Claude (entirely optional) --------------------------------------------
# Leave this unset and everything scheduled still works, for free.
# Set it to wake the manager and the five desks.
# NOTE: this is from console.anthropic.com and is billed separately from any
# Claude subscription you may already pay for.
# ANTHROPIC_API_KEY=sk-ant-...

# Model choices. Staff run many short lookups; switching them to
# claude-sonnet-5 roughly halves the cost of a busy day.
# MANAGER_MODEL=claude-opus-5
# STAFF_MODEL=claude-opus-5

# Hard daily ceiling in USD. Also editable in the app_settings table.
DAILY_SPEND_CAP_USD=1.00
