# Copy to .env.local for local development. On Vercel these go in
# Project Settings -> Environment Variables.

# From Supabase: Project Settings -> API
# The URL and the anon/publishable key are safe to expose -- they reach the
# browser by design, and every table is behind deny-by-default RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# This one is NOT safe to expose. It bypasses every security policy.
# It is only ever read on the server -- lib/db.ts imports "server-only", so the
# build fails rather than shipping it to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Who may sign in. Comma separated. An EMPTY value lets nobody in, deliberately.
ADMIN_ALLOWED_EMAILS=you@example.com
